<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pilot_launch</name>
  <version>0.3.0</version>
  <description>Launch configuration for PilotZero autonomous driving system</description>
  <maintainer email="developer@pilotzero.com">PilotZero Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  
  <!-- Module dependencies -->
  <exec_depend>common</exec_depend>
  <exec_depend>planning</exec_depend>
  <exec_depend>localization</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>control</exec_depend>
  <exec_depend>map</exec_depend>
  <exec_depend>visualization</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
