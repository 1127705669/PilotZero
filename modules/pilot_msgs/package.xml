<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pilot_msgs</name>
  <version>0.3.0</version>
  <description>Protocol buffer messages for PilotZero autonomous driving system</description>
  <maintainer email="ethan.liqi.yi@gmail.com">PilotZero Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <!-- Protocol Buffers -->
  <build_depend>libprotobuf-dev</build_depend>
  <build_depend>protobuf-compiler</build_depend>
  <exec_depend>libprotobuf-dev</exec_depend>

  <depend>rosidl_default_generators</depend>
  <depend>rosidl_default_runtime</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
